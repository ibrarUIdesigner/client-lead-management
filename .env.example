APP_ENV=development
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/client_acquisition
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
LOG_LEVEL=INFO

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TEXT_PROVIDER_API_KEY=
IMAGE_PROVIDER_API_KEY=
REDIS_URL=

# Daily business search. OpenStreetMap needs no key. Google Places is used when the key is set.
DISCOVERY_ENABLED=true
DISCOVERY_HOUR=6
DISCOVERY_TIMEZONE=UTC
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# Website audits. Playwright, axe-core, and a small SEO crawl run locally.
# This key runs Lighthouse through PageSpeed Insights (mobile and desktop)
# and real-visitor data through the Chrome UX Report API.
# Enable both APIs on the key. Smaller sites often have no visitor data.
GOOGLE_PAGESPEED_API_KEY=
