APP_ENV=development
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/client_acquisition
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
LOG_LEVEL=INFO

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TEXT_PROVIDER_API_KEY=
IMAGE_PROVIDER_API_KEY=
REDIS_URL=

# Daily business search. OpenStreetMap needs no key. Google Places is used when the key is set.
DISCOVERY_ENABLED=true
DISCOVERY_HOUR=6
DISCOVERY_TIMEZONE=UTC
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# Website audits. Playwright, axe-core, and a small SEO crawl run locally.
# This key runs Lighthouse through PageSpeed Insights (mobile and desktop)
# and real-visitor data through the Chrome UX Report API.
# Enable both APIs on the key. Smaller sites often have no visitor data.
GOOGLE_PAGESPEED_API_KEY=

# Email drafts. Gemini is used when GEMINI_API_KEY is set. Groq is used when only
# GROQ_API_KEY is set. Set AI_EMAIL_PROVIDER to gemini or groq to force one.
# Free Gemini requests may be used to improve Google's products. Drafts send the
# public business details and verified audit findings, not notes or past emails.
GEMINI_API_KEY=
GROQ_API_KEY=
AI_EMAIL_PROVIDER=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile
OUTREACH_SENDER_NAME=

# Gmail send + reply sync. Create an OAuth client in Google Cloud Console
# (APIs & Services → Credentials → OAuth 2.0 Client ID, type Desktop or Web).
# Enable the Gmail API. Add the redirect URI below to Authorized redirect URIs.
# Scopes requested: gmail.send + gmail.readonly (send mail and read replies).
# For personal use, keep the OAuth consent screen in Testing and add your Google
# account as a test user. TOKEN_ENCRYPTION_KEY should be a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback
GMAIL_FRONTEND_REDIRECT_URL=http://localhost:5175/settings
TOKEN_ENCRYPTION_KEY=
GMAIL_SYNC_ENABLED=true
GMAIL_SYNC_INTERVAL_MINUTES=3
GMAIL_API_MAX_RETRIES=4

# Apify actors. Create a token at https://console.apify.com/account/integrations
# The API server reads this value. Do not put the token in frontend code or Vite env.
APIFY_TOKEN=

# Maximum size of a Design MD guide, in bytes. The server enforces this on paste and upload.
DESIGN_MD_MAX_BYTES=262144
